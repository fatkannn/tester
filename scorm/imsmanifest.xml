<?xml version="1.0" encoding="UTF-8"?>
<!-- Manifest SCORM 1.2 untuk simulasi PR AI -> PO Robot.
     Samakan adlcp:masteryscore dengan CONFIG.nilaiLulus (bila LMS mengirim nilai ini,
     simulasi otomatis memakainya). -->
<manifest identifier="SIM_PR_PO_ROBOT" version="1.0"
  xmlns="http://www.imsproject.org/xsd/imscp_rootv1p1p2"
  xmlns:adlcp="http://www.adlnet.org/xsd/adlcp_rootv1p2"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.imsproject.org/xsd/imscp_rootv1p1p2 imscp_rootv1p1p2.xsd http://www.imsglobal.org/xsd/imsmd_rootv1p2p1 imsmd_rootv1p2p1.xsd http://www.adlnet.org/xsd/adlcp_rootv1p2 adlcp_rootv1p2.xsd">
  <metadata>
    <schema>ADL SCORM</schema>
    <schemaversion>1.2</schemaversion>
  </metadata>
  <organizations default="ORG_SIM">
    <organization identifier="ORG_SIM">
      <title>Simulasi: Memproses PR AI ke PO Robot</title>
      <item identifier="ITEM_SIM" identifierref="RES_SIM" isvisible="true">
        <title>Simulasi: Memproses PR AI ke PO Robot</title>
        <adlcp:masteryscore>80</adlcp:masteryscore>
      </item>
    </organization>
  </organizations>
  <resources>
    <resource identifier="RES_SIM" type="webcontent" adlcp:scormtype="sco" href="index.html">
      <file href="index.html"/>
    </resource>
  </resources>
</manifest>
